@page "/"
@using VisionArt.Client.DTOs
@inject VisionArt.Client.Services.ArtApiService ArtService
@inject NavigationManager Navigation

<div class="hero">
    <div class="hero-content">
        <h1>AI Artwork Similarity Search</h1>
        <p>Discover visually similar artworks using AI and CLIP embeddings.</p>

        <div class="hero-buttons">
            <button class="primary-btn">Upload Artwork</button> 
            <NavLink href="/gallery" class="secondary-btn">
                Explore Gallery
            </NavLink>
        </div>
    </div>
</div>

<section class="gallery-preview">
    <h2>Featured Artworks</h2>

    @if (artworks == null)
    {
        <div class="loading-spinner">
            <p>Loading masterpieces...</p>
        </div>
    }
    else if (!artworks.Any())
    {
        <p>No artworks found in the collection.</p>
    }
    else
    {
        <div class="gallery-grid">
            @foreach (var art in artworks.Take(6))
            {
                <div class="art-card">
                    <div class="image-container">
                        <img src="@ArtService.GetImageUrl(art.Id)" alt="@art.Title" loading="lazy" />
                    </div>
                    <div class="art-info">
                        <h4>@art.Title</h4>
                        <p>@art.Artist</p>
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    private List<ArtWorkDto>? artworks;

    protected override async Task OnInitializedAsync()
    {
        artworks = await ArtService.GetAllAsync();
    }
}